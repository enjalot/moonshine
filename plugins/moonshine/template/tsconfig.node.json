{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "velite.config.ts",
    "vite-plugin-moonshine-edit.ts",
    "vite-plugin-moonshine-feedback.ts"
  ]
}
