# Pin exact versions on `npm install` instead of using caret ranges.
# Combined with the strict pins in package.json, this keeps the dep set
# reproducible across machines and resistant to silent upgrades that
# could introduce a compromised version.
save-exact=true

# Refuse to install if node doesn't match the version constraint in
# package.json engines.
engine-strict=true

# Allow scripts only when explicitly opted in (uncomment to harden):
# ignore-scripts=true
